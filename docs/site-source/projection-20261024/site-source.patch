+import test from'node:test';import assert from'node:assert/strict';
+test('projection mode navigation preserves optical state, pauses playback and restores existing modes',async()=>{const items=new Map(),frames=[],context=new Proxy({},{get:()=>()=>{}});function el(tag='div'){const children=new Map();return{tag,parentElement:{hidden:false},children:[],dataset:{},style:{},classList:{toggle(){}},append(e){this.children.push(e)},setAttribute(k,v){this[k]=v},getContext:()=>context,getBoundingClientRect:()=>({width:1050,height:620}),querySelector(k){if(!children.has(k))children.set(k,el());return children.get(k)},querySelectorAll(){return[]},setPointerCapture(){},click(){},textContent:'',value:'',files:[],hidden:false};}globalThis.document={getElementById(id){if(!items.has(id))items.set(id,el());return items.get(id)},createElement:el,querySelectorAll:()=>[]};globalThis.window={};globalThis.Path2D=class{};globalThis.devicePixelRatio=1;globalThis.requestAnimationFrame=f=>frames.push(f);globalThis.ResizeObserver=class{observe(){}};await import('../candidate/app.mjs');const $=id=>items.get(id);const before=window.kryptosQA.state();$('play').onclick();$('projectionMode').onclick();assert.equal($('play').textContent,'▶ Play day');assert.equal($('workbench').hidden,true);assert.equal($('projectionPanel').hidden,false);assert.equal($('projectionMode')['aria-pressed'],'true');assert.deepEqual(window.kryptosQA.state(),before);$('opticalMode').onclick();assert.equal($('projectionPanel').hidden,true);assert.equal($('workbench').hidden,false);assert.equal($('headerLight').hidden,false);$('projectionFromShadow').onclick();assert.equal($('projectionPanel').hidden,false);$('foldMode').onclick();assert.equal($('projectionPanel').hidden,true);assert.equal($('foldPanel').hidden,false);$('projectionMode').onclick();assert.equal($('foldPanel').hidden,true);assert.equal($('projectionPanel').hidden,false);assert.deepEqual(window.kryptosQA.state(),before);});
