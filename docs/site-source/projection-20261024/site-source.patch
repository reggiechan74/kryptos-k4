+import{diagnose,prediction}from'./core.mjs';import{initialProjectionState,validateProjectionState,syntheticInput}from'./synthetic.mjs';import{diagram}from'./view.mjs';import{RESEARCH_PROVENANCE}from'./fixtures.mjs';
+const names={finite:'Finite image intersection · adjustable',infinity:'Parallel image rays · intersection at infinity',distant_finite:'Finite off-screen image intersection',noisy_finite:'Research fixture · noisy endpoint picks',heldout_mutation:'Wrong held-out correspondences · training unchanged',mixed_sources:'Mixed image intersections',coincident_lines:'Coincident lines · nonunique fit',collapsed:'Collapsed endpoints · invalid geometry'};
+export function mountProjectionTest(host){let state=initialProjectionState(),mode='synthetic',last;const $=id=>host.querySelector('#'+id);host.innerHTML=`<p class="eyebrow">SHADOW VISUALIZATION · IMAGE-SPACE DIAGNOSTIC</p><h2>Do the projected rays meet?</h2><p>A material point in a letter opening and its illuminated ground point define an image line. For an ideal point source, independently identified pairs should share an image intersection. Fit some pairs, then inspect the predicted <strong>line</strong> for pairs kept out of the fit.</p><p class="modelnote">Concurrence is necessary, not sufficient. It cannot identify sunlight versus a lamp or reflected source, establish actual 3D concurrence, or solve K4. This synthetic image experiment does not calibrate the sculpture model.</p><div class="projection-tabs"><button id="projection-synthetic" aria-pressed="true">Synthetic demonstration</button><button id="projection-photo" aria-pressed="false">Photograph · 0 certified pairs</button></div><section id="projection-synthetic-panel"><div class="projection-controls"><label>Teaching fixture<select id="projection-fixture">${Object.entries(names).map(([k,v])=>`<option value="${k}">${v}</option>`).join('')}</select></label><fieldset><legend>Adjust finite image intersection (pixels)</legend><label>x<input id="projection-x" type="number" min="-10000" max="10000" step="10"></label><label>y<input id="projection-y" type="number" min="-10000" max="10000" step="10"></label></fieldset><label>Added endpoint noise σ (px)<input id="projection-noise" type="range" min="0" max="10" step=".25"><output id="projection-noise-read"></output></label><label>Local wrong pick · held-out pair 3 (px)<input id="projection-mismatch" type="range" min="-80" max="80" step=".25"><output id="projection-mismatch-read"></output></label><label>Declared pick uncertainty σ (px)<input id="projection-sigma" type="number" min=".01" max="20" step=".05"></label><label>Inspect pair<select id="projection-selected">${Array.from({length:12},(_,i)=>`<option value="${i}">${i+1}</option>`).join('')}</select></label><label><input id="projection-lines" type="checkbox"> Show predicted rays</label><button id="projection-reset">Reset synthetic controls</button><button id="projection-export">Export diagnostic JSON</button></div><p id="projection-notice" role="status"></p><div class="projection-layout"><div><div id="projection-diagram"></div><p class="projection-legend">○ Aperture · ■ receiver pick · mint = 8 training pairs · dashed gold = 4 held-out rays · coral = perpendicular miss. Original image frame 1000 × 800 px; off-screen endpoints remain in the calculation.</p></div><aside><div id="projection-summary" aria-live="polite"></div><div id="projection-inspection"></div></aside></div><details><summary>All pairs, coordinates and residuals</summary><div class="projection-table"><table><thead><tr><th>Pair</th><th>Role</th><th>Aperture x,y</th><th>Receiver x,y</th><th>Signed miss px</th></tr></thead><tbody id="projection-rows"></tbody></table></div></details><p class="modelnote">Two distinct lines always intersect: that alone is not a test. Three first overidentify the fit; the 8/4 partition here is a teaching design, not a sufficiency theorem. Parallel distinct lines can meet at a valid image point at infinity; coincident lines lose rank.</p><p>Uncertainty display is <strong>endpoint-only</strong>, assuming independent isotropic picks at both endpoints. It omits fitted-source uncertainty and shared model error; no confidence level, p-value or acceptance verdict is claimed. Finite Sun size, copper thickness, occlusion, lens distortion and using glyph centers instead of matching material points can break the ideal model.</p><details><summary>Algorithm and reproducibility</summary><p>Normalized line scatter matrix, smallest eigenvector; relative eigen-gap below 10⁻⁷ warns of a weak/nonunique fit. Fixed seed 29029; added noise uses deterministic LCG + Box–Muller samples. The unchanged research fixtures are cross-checked against the Python contract. The research report’s separately perturbed, combined uncertainty scores are not these endpoint-only values.</p><a href="projection-test/RESEARCH_API.md">Mathematical contract</a></details></section><section id="projection-photo-panel" hidden><h3>Observed illumination, not established correspondences</h3><p><strong>0 certified pairs · 0 real-photo fits.</strong> The photograph shows letter-shaped illumination on paving. No independently identified aperture-to-ground material-point pairs are available, so no fitted rays or image-source claim are drawn.</p><figure class="projection-photo"><img src="projection-test/loc-highsmith-site.jpg" width="1580" height="2000" alt="Curved cut-out copper Kryptos screen with bright letter-shaped illumination on the paving beneath it."><figcaption>Photographs in the Carol M. Highsmith Archive, Library of Congress, Prints and Photographs Division. <a href="https://www.loc.gov/pictures/item/2011631531/" target="_blank" rel="noreferrer">LOC record 2011631531</a> · publication advisory: “No known restrictions on publication.” Resized 1580 × 2000 derivative; no camera calibration or exposure time established here.</figcaption></figure><p>Before a real test: establish material-point identities independently; retain original image coordinates, both endpoint uncertainties, camera assumptions and a predeclared model-error budget. The Site’s separate non-K4 cross-view glyph-registration evidence does not provide these aperture-to-ground pairs.</p></section><p class="modelnote">A finite <em>image intersection</em> is not a finite physical lamp. Directional sunlight can have a finite image vanishing point. An image point at infinity describes image geometry, not source distance; a finite emitter in the camera-center plane can also project there. Small residuals do not certify the identities of the paired points.</p>`;
+const fmt=x=>x===null?'undefined':Number(x).toFixed(3),xy=p=>p.map(fmt).join(', ');
+function render(){const f=syntheticInput(state);let result=null,error='';try{result=diagnose(f.pairs,f.width,f.height,f.training);}catch(e){error=e.message;}last={schema:'kryptos-projection-diagnostic/1',kind:'synthetic only',state:structuredClone(state),input:f,result,provenance:RESEARCH_PROVENANCE,realCertifiedPairs:0,realFits:0};for(const[id,key]of[['fixture','fixture'],['x','sourceX'],['y','sourceY'],['noise','noise'],['mismatch','mismatch'],['sigma','sigma'],['selected','selected']])$('projection-'+id).value=state[key];$('projection-lines').checked=state.lines;$('projection-x').disabled=$('projection-y').disabled=state.fixture!=='finite';$('projection-noise-read').textContent=state.noise+' px';$('projection-mismatch-read').textContent=state.mismatch+' px';$('projection-diagram').innerHTML=diagram(f,result,state);const fit=result?.fit,weak=fit?.warnings.includes('nonunique_or_ill_conditioned_source'),p=fit?.source_image_finite;let source=error?'No fit: '+error:weak?'Nonunique / weak fit: do not interpret the displayed eigenvector as an identified source.':p?`Finite image intersection: (${xy(p)}) px${p[0]<0||p[0]>f.width||p[1]<0||p[1]>f.height?' · off-screen; not clamped':''}`:`Image point at infinity · homogeneous direction (${fit.source_image_homogeneous.map(fmt).join(', ')})`; $('projection-summary').textContent=source+(fit?`\nRelative eigen-gap: ${fit.relative_eigen_gap.toPrecision(4)}\nHeld-out perpendicular-miss RMS: ${fmt(result.heldout_miss_rms_px)} px\nEndpoint-only standardized RMS: ${fmt(result.heldout_endpoint_only_rms)}\n${fit.warnings.join('; ')}`:'');const pair=f.pairs[state.selected],row=result?.residuals[state.selected],pred=fit&&!weak?prediction(pair,fit.source_image_homogeneous):null;$('projection-inspection').textContent=`Pair ${state.selected+1} · ${f.training.includes(state.selected)?'training':'HELD OUT'}\nAperture: (${xy(pair.aperture)}) px\nReceiver: (${xy(pair.receiver)}) px\n${row?'Signed line miss: '+fmt(row.signed_miss_px)+' px · '+row.status:'No residual available'}\n${pred?'Predicted image ray: '+pred.line.map(fmt).join(', ')+' · (a x + b y + c = 0). The receiver can slide along this line; depth is undetermined.':'No unique predicted ray to inspect.'}`;$('projection-rows').innerHTML=f.pairs.map((p,i)=>`<tr><td>${i+1}</td><td>${f.training.includes(i)?'train':'held out'}</td><td>${xy(p.aperture)}</td><td>${xy(p.receiver)}</td><td>${fmt(result?.residuals[i].signed_miss_px??null)}</td></tr>`).join('');}
+function edit(patch){try{state=validateProjectionState({...state,...patch});$('projection-notice').textContent='';render();}catch(e){$('projection-notice').textContent='Change rejected: '+e.message;render();}}
+for(const[id,key]of[['fixture','fixture'],['x','sourceX'],['y','sourceY'],['noise','noise'],['mismatch','mismatch'],['sigma','sigma'],['selected','selected']])$('projection-'+id).onchange=()=>{const value=$('projection-'+id).value;edit({[key]:key==='fixture'?value:value.trim()===''?NaN:Number(value)});};$('projection-lines').onchange=()=>edit({lines:$('projection-lines').checked});$('projection-reset').onclick=()=>{state=initialProjectionState();render();};for(const tab of ['synthetic','photo'])$('projection-'+tab).onclick=()=>{mode=tab;for(const key of ['synthetic','photo']){$('projection-'+key+'-panel').hidden=key!==mode;$('projection-'+key).setAttribute('aria-pressed',String(key===mode));}};$('projection-export').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(last,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download='kryptos-synthetic-concurrence-v1.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};render();return{getState:()=>({mode,...structuredClone(state)}),getDiagnostic:()=>structuredClone(last)};}
