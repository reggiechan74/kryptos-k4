diff --git a/tests/fold-overlay.test.mjs b/tests/fold-overlay.test.mjs
new file mode 100644
index 0000000..c1316d0
--- /dev/null
+++ b/tests/fold-overlay.test.mjs
@@ -0,0 +1,8 @@
+import test from'node:test';import assert from'node:assert/strict';import{readFileSync}from'node:fs';import{FOLD_DATA}from'../dist/fold-overlay/data.mjs';import{CIPHER,TABLEAU,WIDTH,HEIGHT,initialFoldState,validateFoldState,foldStep,compareFold,horizontalReflection,glyphReflection,exportFold}from'../dist/fold-overlay/core.mjs';import{mountFoldOverlay}from'../dist/fold-overlay/module.mjs';
+test('all134 canonical offline column-only frames match every numerical endpoint exactly at row0',()=>{const records=JSON.parse(readFileSync(new URL('./fold-offline-records.json',import.meta.url)));assert.equal(records.length,134);for(const record of records){const n=compareFold({...initialFoldState(),model:record.model,column:record.shift}).stats;for(const key of['geometric_overlap_cells','comparable_letter_pairs','label_matches','common_pixel_area','nonempty_common_aperture_pairs','full_mask_coincidences','union_pixel_area','common_over_union','label_match_fraction'])assert.equal(n[key],record[key],record.model+' / '+record.shift+' / '+key);}});
+test('anchored same-facing registration reproduces MYVGT/AABCD and both reflections cancel glyph and cell handedness',()=>{assert.equal(CIPHER.slice(0,5).map(r=>r[1]).join(''),'MYVGT');assert.equal(TABLEAU.OBSERVED_RENDER33.slice(0,5).map(r=>r[1]).join(''),'AABCD');assert.equal(CIPHER[0][0],'E');for(const pattern of Object.values(FOLD_DATA.glyphs))assert.deepEqual(glyphReflection(glyphReflection(pattern)),pattern);for(const rows of[CIPHER,...Object.values(TABLEAU)])assert.deepEqual(horizontalReflection(horizontalReflection(rows)),rows);assert.deepEqual(compareFold(initialFoldState()).cells.filter(c=>c.c===1&&c.r<5).map(c=>c.common),[12,2,7,13,5]);});
+test('repeated unit steps, extremes and reset state do not wrap or skip cells',()=>{let s=initialFoldState();for(let i=1;i<=33;i++){s=foldStep(s,'column',1);assert.equal(s.column,i);}assert.equal(foldStep(s,'column',1).column,33);for(const column of[-33,33])for(const row of[-28,0,28]){const n=compareFold({...s,column,row});assert.equal(n.stats.geometric_overlap_cells,0);assert.equal(n.stats.label_matches,0);assert.equal(n.stats.common_over_union,null);assert.equal(n.stats.label_match_fraction,null);assert.ok(n.cells.every(c=>!c.inside));}for(const row of[-28,28])assert.equal(compareFold({...s,column:0,row}).stats.geometric_overlap_cells,0);assert.deepEqual(initialFoldState(),{model:'OBSERVED_RENDER33',column:0,row:0,view:'labels',inspectRow:1,inspectColumn:2});});
+test('row and column translations compose and preserve source coordinates, punctuation and padding',()=>{const a=foldStep(foldStep(initialFoldState(),'row',1),'column',-1),b=foldStep(foldStep(initialFoldState(),'column',-1),'row',1);assert.deepEqual(a,b);const n=compareFold(a);assert.equal(n.stats.geometric_overlap_cells,(WIDTH-1)*(HEIGHT-1));for(const cell of n.cells){if(cell.inside){assert.equal(cell.tableau.row,cell.r);assert.equal(cell.tableau.modelColumn,cell.c+2);assert.equal(cell.b,TABLEAU[a.model][cell.r-1][cell.c+1]);}if(cell.a==='?'||cell.b==='?'||cell.a===' '||cell.b===' ')assert.equal(cell.match,false);}const raw=JSON.parse(exportFold(a));assert.equal(raw.state.row,1);assert.equal(raw.state.column,-1);assert.match(raw.statisticsScope,/exploratory/);assert.equal(raw.glyphs['?'].length,7);assert.deepEqual(raw.matches,n.matches);assert.equal(compareFold(initialFoldState()).matches.filter(m=>m.k4).map(m=>m.k4).join(','),'14,44,72,95');});
+test('integer validation rejects nonfinite, fractional and outside input atomically',()=>{const baseline=initialFoldState();for(const v of[NaN,Infinity,1.5,34,-34])assert.throws(()=>validateFoldState({...baseline,column:v}));for(const v of[NaN,Infinity,1.5,29,-29])assert.throws(()=>validateFoldState({...baseline,row:v}));assert.deepEqual(baseline,initialFoldState());});
+test('manual controls advance by one, reset anchored state, restore invalid input and report no-overlap denominators',()=>{const items=new Map(),el=()=>({value:'',textContent:'',innerHTML:'',disabled:false});const host={querySelector(id){if(!items.has(id))items.set(id,el());return items.get(id)}};const c=mountFoldOverlay(host),$=id=>items.get('#'+id);$('fold-col-plus').onclick();$('fold-col-plus').onclick();$('fold-row-minus').onclick();assert.equal(c.getState().column,2);assert.equal(c.getState().row,-1);assert.match($('fold-scope').textContent,/EXPLORATORY/);$('fold-column').value='1.5';$('fold-column').oninput();assert.equal(c.getState().column,2);assert.equal($('fold-column').value,2);assert.match($('fold-notice').textContent,/rejected/);c.setState({column:33,row:0});assert.match($('fold-metrics').innerHTML,/No two-layer overlap/);c.setState({model:'DUNIN_HEADER33',row:2});$('fold-reset').onclick();assert.deepEqual(c.getState(),initialFoldState());assert.match($('fold-metrics').innerHTML,/35 \/ 856/);});
+test('pinned observed rows and aperture dictionary remain identical to the shipped canonical source',async()=>{const{CIPHER_ROWS,TABLEAU_ROWS}=await import('../dist/transcript.mjs');const{bridgedGlyphs}=await import('../dist/glyphs.mjs');assert.deepEqual(FOLD_DATA.input.cipher_rows,CIPHER_ROWS);assert.deepEqual(FOLD_DATA.input.models.OBSERVED_RENDER33,TABLEAU_ROWS);for(const[letter,mask]of Object.entries(FOLD_DATA.glyphs))assert.deepEqual(mask,bridgedGlyphs[letter],letter);});
