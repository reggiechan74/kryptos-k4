+<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Manual fold overlay responsive QA</title><style>body{background:#18251f;color:#edf2e9;font:14px system-ui}iframe{display:block;max-width:none;border:2px solid #d3edb4;margin:20px 0}pre{white-space:pre-wrap}</style><h1>Manual fold overlay QA</h1><p>Complete Site at390px and1280px. These are iframe layout and control checks, not physical-fold or touch-device validation.</p><p id="summary" role="status">Running…</p><pre id="details"></pre><script type="module">
+const rows=[];for(const width of[390,1280]){const frame=document.createElement('iframe');frame.width=width;frame.height=1050;frame.title=`Manual fold at${width}px`;document.body.append(frame);const ready=new Promise(r=>frame.onload=r);frame.src='../dist/#foldPanel';await ready;const d=frame.contentDocument;for(let i=0;i<250&&!frame.contentWindow.kryptosQA;i++)await new Promise(r=>setTimeout(r,20));const previous=JSON.stringify(frame.contentWindow.kryptosQA.state());d.getElementById('foldMode').click();const panel=d.getElementById('foldPanel'),$=id=>panel.querySelector('#'+id);const zero=$('fold-metrics').textContent.includes('35 / 856');$('fold-col-plus').click();$('fold-col-plus').click();$('fold-row-minus').click();const steps=$('fold-col-value').textContent==='+2'&&$('fold-row-value').textContent==='-1',scope=$('fold-scope').textContent.includes('EXPLORATORY');$('fold-column').value=33;$('fold-column').dispatchEvent(new frame.contentWindow.Event('input'));const empty=$('fold-metrics').textContent.includes('No two-layer overlap');$('fold-reset').click();const reset=$('fold-col-value').textContent==='+0'&&$('fold-row-value').textContent==='+0'&&$('fold-metrics').textContent.includes('35 / 856');$('fold-view').value='intersection';$('fold-view').dispatchEvent(new frame.contentWindow.Event('change'));const aperture=!!$('fold-board').querySelector('path');const board=$('fold-board'),oldLeft=board.scrollLeft;board.scrollLeft=100;const scroll=board.scrollWidth>board.clientWidth?board.scrollLeft>oldLeft:true;const unchanged=JSON.stringify(frame.contentWindow.kryptosQA.state())===previous;d.getElementById('entranceMode').click();const entrance=!d.getElementById('entrancePanel').hidden&&panel.hidden;d.getElementById('opticalMode').click();const returned=!d.getElementById('workbench').hidden&&panel.hidden;d.getElementById('foldMode').click();await new Promise(r=>frame.contentWindow.requestAnimationFrame(r));const overflow=d.documentElement.scrollWidth>width;rows.push({width,anchoredCount:zero,unitSteps:steps,rowScopeExploratory:scope,emptyOverlap:empty,reset,aperturePathPresent:aperture,internalScrollWorks:scroll,opticalStateUnchanged:unchanged,entrancePreserved:entrance,returnsToOptics:returned,pageOverflow:overflow,pass:zero&&steps&&scope&&empty&&reset&&aperture&&scroll&&unchanged&&entrance&&returned&&!overflow});document.getElementById('details').textContent=JSON.stringify(rows,null,2);document.getElementById('summary').textContent=rows.every(r=>r.pass)?'PASS checked widths: '+rows.map(r=>r.width).join(', '):'FAIL';}document.getElementById('summary').textContent=(rows.every(r=>r.pass)?'PASS both widths and controls':'FAIL')+' · '+rows.map(r=>r.width+'px overflow '+r.pageOverflow+', steps '+r.unitSteps+', reset '+r.reset+', optics unchanged '+r.opticalStateUnchanged).join(' · ');
+</script>
