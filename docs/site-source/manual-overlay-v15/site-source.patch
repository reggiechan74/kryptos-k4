+import{FOLD_DATA}from'./data.mjs';import{initialFoldState,validateFoldState,foldStep,compareFold,exportFold,WIDTH,HEIGHT}from'./core.mjs';import{foldBoard}from'./view.mjs';
+export function mountFoldOverlay(host){let state=initialFoldState(),result;const $=id=>host.querySelector('#'+id);host.innerHTML=`<p class="eyebrow">MANUAL TRANSCRIPT EXPERIMENT</p><h2>Fold once. Slide one cell at a time.</h2><p>The tableau is initially mirror-facing in the cipher-front view. Reflecting it across the fold reverses it again: <strong>the folded glyphs face the same way</strong>. This explorer starts after that double reflection. Shift the folded tableau against the fixed ciphertext; nothing wraps around an edge.</p><p class="modelnote">Anchored reset: centered 33-column model column 2 reads <strong>MYVGT</strong> opposite <strong>AABCD</strong>, including header A then row keys A/B/C/D. The first-row cipher E protrudes one cell farther. These are render-registration observations, not a surveyed pole coordinate or a decipherment.</p><div class="fold-controls"><fieldset><legend>Folded tableau column offset</legend><div class="fold-step"><button id="fold-col-minus" aria-label="Shift tableau one column negative">−1 column</button><output id="fold-col-value" aria-live="polite"></output><button id="fold-col-plus" aria-label="Shift tableau one column positive">+1 column</button></div><input id="fold-column" type="range" min="-33" max="33" step="1" aria-label="Column offset"></fieldset><fieldset><legend>Folded tableau row offset</legend><div class="fold-step"><button id="fold-row-minus" aria-label="Shift tableau one row negative">−1 row</button><output id="fold-row-value" aria-live="polite"></output><button id="fold-row-plus" aria-label="Shift tableau one row positive">+1 row</button></div><input id="fold-row" type="range" min="-28" max="28" step="1" aria-label="Row offset"></fieldset></div><p>Positive columns move the tableau right; positive rows move it down. Compare C[r,c] with T[r−row offset,c−column offset].</p><div class="fold-options"><label>Registration<select id="fold-model"><option value="OBSERVED_RENDER33">Observed render · anchored primary</option><option value="DUNIN_HEADER33">Dunin header · sensitivity case</option></select></label><label>Display<select id="fold-view"><option value="labels">Exact letter-label comparison · C above T</option><option value="intersection">Approximate common aperture openings</option><option value="cipher">Cipher aperture masks only</option><option value="tableau">Folded tableau aperture masks only</option></select></label><button id="fold-reset">Reset anchored full overlap</button><button id="fold-export">Export offsets & match positions JSON</button></div><p id="fold-notice" role="status"></p><p id="fold-scope" class="modelnote"></p><p class="fold-legend"><span>■ Copper: cipher C</span><span>■ Mint: folded tableau T</span><span>□ Green: exact A–Z match</span><span>□ Amber: inspected cell</span><span>Dashed edge: translated tableau boundary</span></p><div class="fold-layout"><div id="fold-board" class="fold-scroll" tabindex="0" aria-label="Scrollable comparison grid; inspect cells with the row and column fields"></div><div><div id="fold-metrics" class="fold-metrics" aria-live="polite"></div><fieldset><legend>Inspect a fixed cipher cell</legend><label>Model row (1–28)<input id="fold-inspect-row" type="number" min="1" max="28" step="1"></label><label>Model column (1–33)<input id="fold-inspect-column" type="number" min="1" max="33" step="1"></label></fieldset><p id="fold-inspector" class="mono"></p><p>Click the grid, or use the fields above. Source columns exclude automatic centering padding; literal blanks and question marks remain intact. Outside is not a blank/wildcard.</p></div></div><details><summary>Current exact matches and source coordinates</summary><p>Read in fixed cipher row-major order. These are ciphertext/tableau coincidences, not a plaintext extraction.</p><pre id="fold-matches"></pre></details><details><summary>Approximation, prior tests and reproducibility</summary><p>5×7 modeled square-aperture glyphs are approximate, <strong>not measured sculpture contours</strong>. The common-opening display uses per-pixel intersection for flat coincident parallel sheets, equal scale/baseline and normal rays. It does not use the courtyard’s Sun, curvature or thickness model. Different letters can share openings. Solid padding counts as geometric overlap; outside cells are excluded. Common/union pixel area is a mask ratio, not measured light or an exact-label score.</p><p>The prior systematic study covered columns −33…+33, both registrations, at row offset 0. Any nonzero row shift here is <strong>exploratory and was not statistically tested in that study</strong>. No column-only p-value is applied to row offsets or manual selections. The prior column scan found no unusual excess under its two conditional null models.</p><p><a href="https://github.com/reggiechan74/kryptos-k4/blob/${FOLD_DATA.researchSourceCommit}/research/MONUMENT-FOLD-SLIDE-FINDINGS.md" target="_blank" rel="noreferrer">Pinned research findings and protocol</a> · <a href="https://www.elonka.com/kryptos/transcript.html" target="_blank" rel="noreferrer">Canonical transcript</a></p><p class="mono">Research source ${FOLD_DATA.researchSourceCommit}. Reset chooses the primary anchored registration and zero row/column offsets.</p></details>`;
+ function input(id){const raw=String($(id).value);if(!raw.trim()||!Number.isInteger(Number(raw)))throw Error('Enter an integer value.');return Number(raw);}
+ function commit(change){try{state=validateFoldState({...state,...change});$('fold-notice').textContent='';render();return true;}catch(e){$('fold-notice').textContent='Input rejected: '+e.message;sync();return false;}}
+ function sync(){for(const[id,key]of[['fold-column','column'],['fold-row','row'],['fold-model','model'],['fold-view','view'],['fold-inspect-row','inspectRow'],['fold-inspect-column','inspectColumn']])$(id).value=state[key];$('fold-col-value').textContent=(state.column>=0?'+':'')+state.column;$('fold-row-value').textContent=(state.row>=0?'+':'')+state.row;$('fold-col-minus').disabled=state.column===-WIDTH;$('fold-col-plus').disabled=state.column===WIDTH;$('fold-row-minus').disabled=state.row===-HEIGHT;$('fold-row-plus').disabled=state.row===HEIGHT;}
+ function render(){sync();result=compareFold(state);const n=result.stats,ratio=(a,b)=>b?(100*a/b).toFixed(2)+'%':'undefined';$('fold-board').innerHTML=foldBoard(result,state.view);$('fold-scope').textContent=state.row===0?'Row offset 0: counts reproduce the pinned column-only experiment. Manual selection is descriptive, not a new significance test.':'EXPLORATORY ROW SHIFT: no prior statistical test or column-only p-value validates this offset.';$('fold-metrics').innerHTML=`<h3>Exact labels</h3><p><strong>${n.label_matches} / ${n.comparable_letter_pairs}</strong> comparable A–Z pairs · ${ratio(n.label_matches,n.comparable_letter_pairs)}</p><h3>Approximate apertures</h3><p><strong>${n.nonempty_common_aperture_pairs} / ${n.geometric_overlap_cells}</strong> overlapping cells have any common opening</p><p>Common pixels ${n.common_pixel_area}; union pixels ${n.union_pixel_area}; common/union ${ratio(n.common_pixel_area,n.union_pixel_area)}. Full nonempty mask coincidences ${n.full_mask_coincidences}.</p><p>${n.geometric_overlap_cells?'Geometric overlap includes solid blanks and punctuation. Question marks/blanks are never exact-label wildcards.':'No two-layer overlap remains. All ratios are undefined; no wrapping.'}</p>`;
+ const cell=result.cells[(state.inspectRow-1)*WIDTH+state.inspectColumn-1],source=s=>s?`source row ${s.row}, column ${s.column??'padding'} (model column ${s.modelColumn})`:'outside translated sheet';$('fold-inspector').textContent=`C: ${cell.a===' '?'solid blank':cell.a} · ${source(cell.cipher)}\nT: ${cell.b===null?'outside':cell.b===' '?'solid blank':cell.b} · ${source(cell.tableau)}\n${cell.match?'Exact A–Z match':'No exact A–Z match'} · common aperture pixels ${cell.common}${cell.k4?' · K4 position '+cell.k4:''}`;$('fold-matches').textContent=result.matches.length?result.matches.map(m=>`${m.letter} · C r${m.cipher.row} c${m.cipher.column} [model ${m.cipher.modelColumn}] ↔ T r${m.tableau.row} c${m.tableau.column} [model ${m.tableau.modelColumn}]${m.k4?' · K4 #'+m.k4:''}`).join('\n'):'No exact A–Z matches.';}
+ for(const[id,axis,step]of[['fold-col-minus','column',-1],['fold-col-plus','column',1],['fold-row-minus','row',-1],['fold-row-plus','row',1]])$(id).onclick=()=>commit(foldStep(state,axis,step));
+ for(const[id,key]of[['fold-column','column'],['fold-row','row'],['fold-inspect-row','inspectRow'],['fold-inspect-column','inspectColumn']])$(id).oninput=()=>{try{commit({[key]:input(id)});}catch(e){$('fold-notice').textContent='Input rejected: '+e.message;sync();}};
+ $('fold-model').onchange=()=>commit({model:$('fold-model').value});$('fold-view').onchange=()=>commit({view:$('fold-view').value});$('fold-reset').onclick=()=>{state=initialFoldState();$('fold-notice').textContent='Anchored full overlap restored.';render();};$('fold-board').onclick=e=>{const cell=e.target.closest?.('[data-r][data-c]');if(cell)commit({inspectRow:Number(cell.dataset.r),inspectColumn:Number(cell.dataset.c)});};$('fold-export').onclick=()=>{const blob=new Blob([exportFold(state)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`kryptos-fold-c${state.column}-r${state.row}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};render();return{getState:()=>({...state}),setState:next=>commit(next),reset(){state=initialFoldState();render();},export:()=>exportFold(state)};
+}
