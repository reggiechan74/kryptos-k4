+import {FOLD_DATA}from'./data.mjs';
+export const WIDTH=FOLD_DATA.input.width,HEIGHT=FOLD_DATA.input.rows,MODELS=Object.keys(FOLD_DATA.input.models),ZERO=Array(7).fill('00000');
+export const centered=rows=>rows.map(row=>{const offset=Math.floor((WIDTH-row.length)/2);return' '.repeat(offset)+row+' '.repeat(WIDTH-row.length-offset);});
+export const CIPHER=centered(FOLD_DATA.input.cipher_rows),TABLEAU=Object.fromEntries(MODELS.map(key=>[key,centered(FOLD_DATA.input.models[key])]));
+export function horizontalReflection(rows){return rows.map(row=>[...row].reverse().join(''));}
+export function glyphReflection(rows){return horizontalReflection(rows);}
+export const initialFoldState=()=>({model:'OBSERVED_RENDER33',column:0,row:0,view:'labels',inspectRow:1,inspectColumn:2});
+export function validateFoldState(s){if(!s||!MODELS.includes(s.model)||!Number.isInteger(s.column)||Math.abs(s.column)>WIDTH||!Number.isInteger(s.row)||Math.abs(s.row)>HEIGHT||!['labels','intersection','cipher','tableau'].includes(s.view)||!Number.isInteger(s.inspectRow)||s.inspectRow<1||s.inspectRow>HEIGHT||!Number.isInteger(s.inspectColumn)||s.inspectColumn<1||s.inspectColumn>WIDTH)throw Error('Use integer offsets: columns −33…+33, rows −28…+28; inspect within the 28×33 grid.');return{...s};}
+export function foldStep(s,axis,amount){if(!['row','column'].includes(axis)||!Number.isInteger(amount))throw Error('Invalid step');const limit=axis==='row'?HEIGHT:WIDTH;return validateFoldState({...s,[axis]:Math.max(-limit,Math.min(limit,s[axis]+amount))});}
+function sourceCell(rows,r,c){if(r<0||r>=HEIGHT||c<0||c>=WIDTH)return null;const text=rows[r],offset=Math.floor((WIDTH-text.length)/2),raw=c-offset;return{row:r+1,column:raw>=0&&raw<text.length?raw+1:null,modelColumn:c+1,char:raw>=0&&raw<text.length?text[raw]:' ',padding:raw<0||raw>=text.length};}
