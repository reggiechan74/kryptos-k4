index 0000000..688ae23
--- /dev/null
+++ b/candidate/fold-overlay/view.mjs
@@ -0,0 +1,8 @@
+import{WIDTH,HEIGHT}from'./core.mjs';
+const CW=23,CH=29;
+export function foldBoard(result,view='labels'){let body='',paths='';for(const cell of result.cells){const x=cell.c*CW,y=cell.r*CH;body+=`<rect x="${x}" y="${y}" width="${CW}" height="${CH}" fill="${cell.inside?'#31443a':'#18251f'}" stroke="#48594c" stroke-width=".45"/>`;if(view==='labels'){if(cell.a!==' ')body+=`<text x="${x+9}" y="${y+14}" fill="#e5a579" font-size="12" opacity=".85">${cell.a==='?'?'?':cell.a}</text>`;if(cell.inside&&cell.b!==' ')body+=`<text x="${x+12}" y="${y+25}" fill="#d3edb4" font-size="12">${cell.b==='?'?'?':cell.b}</text>`;}else{const mask=view==='cipher'?cell.A:view==='tableau'?cell.B:cell.mask;for(let py=0;py<7;py++)for(let px=0;px<5;px++)if(mask[py][px]==='1')paths+=`M${x+4+px*3},${y+4+py*3}h3v3h-3Z`;}
+ if(cell.match)body+=`<rect x="${x+1}" y="${y+1}" width="${CW-2}" height="${CH-2}" stroke="#7fe1a6" stroke-width="1.6" fill="none"/>`;
+ if(cell.r===result.state.inspectRow-1&&cell.c===result.state.inspectColumn-1)body+=`<rect x="${x+2}" y="${y+2}" width="${CW-4}" height="${CH-4}" stroke="#f0cd7b" stroke-width="2" fill="none"/>`;
+ body+=`<rect class="fold-hit" x="${x}" y="${y}" width="${CW}" height="${CH}" fill="transparent" data-r="${cell.r+1}" data-c="${cell.c+1}"/>`;}
+ return`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${WIDTH*CW} ${HEIGHT*CH}" width="${WIDTH*CW}" height="${HEIGHT*CH}" role="img" aria-labelledby="fold-board-title fold-board-desc" style="overflow:hidden"><title id="fold-board-title">Folded tableau comparison, column offset ${result.state.column}, row offset ${result.state.row}</title><desc id="fold-board-desc">Fixed cipher 28 rows by 33 columns. Folded tableau translated without wrapping. Copper labels are cipher; mint labels are tableau. Green frames mark exact A to Z identity, not plaintext. The aperture display uses approximate five by seven masks. Use inspect row and column fields for keyboard inspection.</desc><g font-family="ui-monospace,monospace" text-anchor="middle">${body}</g>${paths?`<path d="${paths}" fill="#fff2c5" pointer-events="none"/>`:''}<rect x="${result.state.column*CW}" y="${result.state.row*CH}" width="${WIDTH*CW}" height="${HEIGHT*CH}" stroke="#d3edb4" stroke-width="3" stroke-dasharray="6,4" fill="none" pointer-events="none"/></svg>`;
+}
