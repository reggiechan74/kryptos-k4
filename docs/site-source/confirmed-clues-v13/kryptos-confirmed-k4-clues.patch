@@ -0,0 +1,4 @@
+import test from 'node:test';import assert from 'node:assert/strict';import{readFileSync}from'node:fs';import{K4}from'../dist/math.mjs';import{K4_CLUES,K4_CLUE_MASK,k4ClueCells,mountK4Clues}from'../dist/k4-clues.mjs';
+test('exact97position confirmed mask has all24known letters and73unknown positions',()=>{assert.equal(K4_CLUE_MASK.length,97);const expected=new Map();for(const[start,word]of[[22,'EAST'],[26,'NORTHEAST'],[64,'BERLIN'],[70,'CLOCK']])for(let i=0;i<word.length;i++)expected.set(start+i,word[i]);assert.equal(expected.size,24);for(let p=1;p<=97;p++)assert.equal(K4_CLUE_MASK[p-1],expected.get(p)??'·','K4position'+p);assert.equal([...K4_CLUE_MASK].filter(c=>c==='·').length,73);assert.equal(K4_CLUE_MASK,'·'.repeat(21)+'EASTNORTHEAST'+'·'.repeat(29)+'BERLINCLOCK'+'·'.repeat(23));for(const clue of K4_CLUES)assert.equal(K4.slice(clue.start-1,clue.start-1+clue.cipher.length),clue.cipher);});
+test('cipher and clue cells share identical columns and adjacent paired rows including first27padding cells',()=>{const cells=k4ClueCells(K4);assert.equal(cells.length,124);assert.equal(cells.filter(c=>c.position).length,97);assert.deepEqual(cells.slice(0,27).map(c=>c.position),Array(27).fill(null));for(const c of cells){assert.ok(c.column>=1&&c.column<=31);assert.equal(c.plainRow,c.cipherRow+1);if(c.position){assert.equal(c.plain,K4_CLUE_MASK[c.position-1]);assert.equal(c.cipher,K4[c.position-1]);assert.equal(c.column,(c.position+26)%31+1);}}assert.deepEqual(cells.filter(c=>c.position===1||c.position===97).map(c=>[c.position,c.column,c.cipherRow,c.plainRow]),[[1,28,1,2],[97,31,7,8]]);});
+test('mounted DOM preserves97indexed cipher buttons and97aligned clue cells with accessible unknown labels',()=>{const make=tag=>({tag,style:{},dataset:{},attributes:{},setAttribute(k,v){this.attributes[k]=v}}),host={children:[],setAttribute(){},append(c){this.children.push(c)}},selected=[];mountK4Clues(host,K4,i=>selected.push(i),{createElement:make});const buttons=host.children.filter(c=>c.tag==='button'),plain=host.children.filter(c=>c.dataset.position);assert.equal(buttons.length,97);assert.equal(plain.length,97);for(let i=0;i<97;i++){assert.equal(buttons[i].style.gridColumn,plain[i].style.gridColumn);assert.equal(+plain[i].style.gridRow,+buttons[i].style.gridRow+1);assert.match(plain[i].attributes['aria-label'],new RegExp('K4 #'+(i+1)+' · '));}buttons[21].onclick();assert.deepEqual(selected,[22]);assert.match(plain[0].className,/unknown/);assert.match(plain[21].className,/known/);const css=readFileSync(new URL('../dist/style.css',import.meta.url),'utf8');assert.match(css,/#letters\{display:grid;grid-template-columns:repeat\(31,1fr\)/);assert.match(css,/@media\(max-width:650px\)\{#letters button,#letters \.k4-clue\{font-size:9px/);});
