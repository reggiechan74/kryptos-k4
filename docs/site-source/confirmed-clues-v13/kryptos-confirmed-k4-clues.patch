-<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kryptos · Light Laboratory</title><link rel="icon" href="icon.svg" type="image/svg+xml"><link rel="stylesheet" href="style.css?rev=20261022-read-safe-r3"></head><body><div role="status" style="padding:12px;background:#593c20;color:#fff1c4;text-align:center;font:14px system-ui">VALIDATION CANDIDATE · accepted decryption + render worker r2 / opaque-set · unpromoted · browser QA pending · <a href="/" style="color:white">verified main application</a></div><header><div class="brand">K / L <span>KRYPTOS · LIGHT LABORATORY</span></div><div class="headerstatus"><strong id="headerLight"></strong><span class="tag">UNSURVEYED MODEL · v4</span></div></header><main><section class="intro"><div><p class="eyebrow">A STUDY IN LIGHT, SHADOW & GEOMETRY</p><h1>Explore how light moves through Kryptos.</h1><p style="max-width:78ch">Kryptos is Jim Sanborn’s encrypted sculpture at CIA headquarters in Langley, Virginia. This interactive laboratory explores a hypothesis: could sunlight passing through its cut-out letters create patterns relevant to its fourth encrypted section, K4?</p><p style="max-width:78ch">Examine how the date, time, light direction and assumed sculpture geometry change the projected light. <a href="https://www.cia.gov/legacy/headquarters/kryptos-sculpture/" target="_blank" rel="noreferrer">About the sculpture · CIA</a> · <a href="#evidence">Evidence & assumptions</a></p><p class="modelnote" style="font-size:12px;max-width:85ch">This is a research simulator, not a demonstrated solution. The reconstruction is not surveyed, and an apparent alignment is not evidence of the artist’s intent.</p></div><div class="metrics"><div><small id="modeRead">REAL SUN</small><strong id="azRead"></strong><span>azimuth · clockwise from north</span></div><div><small>GEOMETRIC ELEVATION</small><strong id="elRead"></strong><span id="dayRead"></span></div></div></section><section aria-labelledby="start-heading" style="border-top:1px solid var(--line);padding:14px 0 22px;margin-bottom:12px"><h2 id="start-heading" style="font:17px Georgia;margin:0">Start here</h2><ol style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px 28px;padding-left:20px;font-size:12px;color:var(--muted)"><li>Choose a date and time for calculated <strong>Real sun</strong>, or select <strong>Manual light</strong> for an experiment.</li><li>Orbit or zoom the model and inspect the letter openings and projected light.</li><li>Change one geometry assumption at a time and compare what moves.</li><li>Export the settings as JSON so a result can be reproduced.</li></ol></section><nav class="mode-navigation" aria-label="Laboratory mode"><button id="opticalMode" aria-pressed="true">Experimental K4 light</button><button id="acceptedMode" aria-pressed="false">How K1–K3 were solved</button></nav><p id="modeGuidance" role="status">Experimental optics: adjust assumptions and inspect projected light. No K4 solution is claimed.</p><div class="workbench" id="workbench"><aside id="lightControls"><div class="sectionhead">01 / LIGHT SOURCE</div><div class="seg"><button id="real">Real sun</button><button id="manual">Manual light</button></div><div id="realControls"><label>New York local date & time<input type="datetime-local" id="local" step="60"></label><small>America/New_York · historical DST. Repeated fall times use earlier occurrence.</small><label>Scrub local day<input id="scrub" type="range" min="0" max="1439" step="5"></label><button id="play">▶ Play day</button><canvas id="path" height="65" aria-label="Daily solar elevation path"></canvas></div><div id="manualControls"><label>Azimuth <output id="maO"></output><input id="ma" type="range" min="0" max="360" value="180"></label><label>Elevation <output id="meO"></output><input id="me" type="range" min="-10" max="90" value="45"></label></div><p id="timeRead" class="mono"></p><div class="sectionhead">02 / PHYSICAL SCENARIOS</div><label>Study extent<select id="extent"><option value="screen">Full screen · two curves</option><option value="crop">Original isolated K4 control</option></select></label><label>Height evidence<select id="heightScenario"><option value="cia8">CIA description · 8 ft / 2.4384 m</option><option value="nsa10">NSA summary · about 3 m (10 ft)</option><option value="custom">Custom hypothesis</option><option value="crop">K4 crop control · assumed height</option></select></label><p id="modelNote" class="modelnote"></p><p class="warning">UNCALIBRATED · all dimensions editable</p><div class="sectionhead">03 / OPTICAL SCENARIOS</div><div id="opticalControls"><label>Copper thickness<select id="thicknessScenario"><option value="ideal">Ideal sheet · 0 mm control</option><option value="reporter-quarter">SPYSCAPE narrative · 6.35 mm</option><option value="memo-half">1991 memo · 12.7 mm</option><option value="custom">Custom hypothesis</option></select></label><label>Custom thickness · mm<input type="number" id="thickness" min="0" max="50" step="0.1"></label><label>Sun source<select id="sunSource"><option value="point">Point-direction control</option><option value="disk">Finite uniform disk · preview</option></select></label><label>Angular radius · degrees<input id="solarRadius" type="range" min="0" max="0.5" step="0.0001"></label><label>Disk quadrature<select id="sunSamples"><option value="9">9 directions · quick preview</option><option value="25">25 directions · preview</option><option value="49">49 directions · slower preview</option><option value="64">64 directions · slow comparison</option></select></label><small>Separate reported thickness alternatives, not a measured uncertainty interval. Finite disk integrates visibility through the entire solid scene. Preview sampling may not resolve narrow penumbras; colors include artistic ambient light, not absolute lux.</small></div><div id="geometry"></div><label class="check"><input type="checkbox" id="boundedReceiver">Bounded receiver patch (hypothesis)</label><div id="physicalControls"><label class="check"><input type="checkbox" id="tree"> Approximate tree at cipher outer end</label><small>Tree shape, size and offset are hypotheses. Its rendered mesh also blocks ground light.</small></div><p id="modelMetrics" class="mono"></p><button id="flat">Flat-screen control · 45°</button><small>Flat, square-on panel. Vertical height projects 1:1 at 45°. Receiver is horizontal.</small></aside><section id="acceptedPanel" hidden><p class="learning-guide">Follow accepted classical decryptions, one letter or transformation at a time. Choose K1, K2 or K3, then Step or Play. The mint marker links an original carved letter to its assumed location on this model; it does not certify its physical dimensions. The corrected K2 insertion has no carved aperture. Camera and light do not participate in these decryptions.</p><div id="acceptedHost"></div></section><section class="viewport"><div class="viewtools"><span id="viewRead">ORTHOGRAPHIC 3D / FULL SCREEN</span><div><button data-view="front">Front</button><button data-view="back">Back</button><button data-view="top">Top</button><button data-view="orbit">Orbit</button><button id="focus">Focus K4</button></div></div><details open class="modelnote"><summary>Measured diagnostics · validation candidate</summary><pre id="diagnostics" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></details><div><button id="retryGeometry">Retry mesh</button><button id="cancelGeometry">Cancel mesh update</button><small>On failure or cancellation, no previous mesh is displayed. Current inputs remain editable.</small></div><div id="renderStatus" role="status" class="modelnote"></div><div class="scene-stack" style="position:relative"><canvas id="scene" aria-label="Interactive 3D copper stencil and geometric ground shadow" tabindex="0"></canvas><canvas id="learningOverlay" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"></canvas></div><div class="scenefoot"><span>Drag to orbit · scroll / pinch to zoom</span><span><i class="copper"></i>Copper <i class="sun"></i>Direct sunlight</span></div><div id="selection" class="selection"></div></section></div><section class="lower"><div class="cipher"><div class="sectionhead">04 / RAW K4 · 97 CHARACTERS</div><p>Canonical K4 uses 31 columns, beginning at row 25, column 28. Full-screen mode preserves the complete cipher and tableau transcript lines (29–33 characters), at an assumed constant physical pitch. Its glyph shapes and spacing are unmeasured. Click a K4 letter to inspect its index.</p><div id="letters"></div><div class="actions"><button id="export">↓ Export state JSON</button><button id="import">↑ Import state JSON</button><button id="reset">Reset</button><button id="observation">Reported observation preset</button><input id="file" type="file" accept="application/json" hidden></div><small>JSON restores optical inputs. Educational selection is included as reference metadata; it does not change the physical solver.</small><p id="notice" role="status"></p></div><div class="evidence" id="evidence"><div class="sectionhead">05 / EVIDENCE & PROVENANCE</div><details open><summary>Computationally verified</summary><p>Geometric ray–plane intersections; shared aperture/material geometry for panel and shadow; 45° / 30° / 60° controls; 97-character transcript and indices; JSON roundtrip; historical DST; solar benchmarks within 0.3°.</p></details><details open><summary>Assumed & approximate</summary><p>Full-screen mode includes both curved text regions, the surrounding cipher, a reverse-reading tableau, an assumed mid-height seam and an approximate tree at the cipher outer end. Two sine lobes, total chord span, heading, clearance and tree size remain hypotheses. CIA describes an 8 ft screen; an NSA summary says about 10 ft. These are competing documentary scenarios, not surveyed certainty. The isolated K4 control omits surrounding text and substitutes 27 blank copper cells for K3. Full-screen glyphs use equal physical stroke cells and approximate counter bridges; they are original generic shapes, not traced serifed hand-cut lettering. Physical pitch is assumed. Copper can be an ideal sheet or a normal-offset solid with aperture walls using separately reported ¼-inch and ½-inch scenarios. Finite uniform solar-disk sampling and tilted/bounded receiver patches are optional numerical experiments. Their preview convergence is not measured site accuracy. Refraction, limb darkening, self-shadow intensity on copper, pools, granite, fasteners, terrain, buildings and photo calibration are omitted. K2 coordinates are a reference location, not a survey.</p></details><details><summary>How to read this experiment</summary><p>Copper blocks sunlight: the dark ground silhouette is the union of its material shadows. The missing copper makes bright letters inside it. Light direction controls ground displacement; incidence depends on each curved surface normal. Camera angle only changes your view. Back views naturally mirror the openings. A projected center marker does not guarantee an unoccluded bright letter.</p></details><details><summary>Unsupported observations & source record</summary><p id="obs">Reported OBKR / NGKSSO / NFBNYP / AUEKCAR groupings are unverified user observations. The preset selects those letters only; it does not tune geometry or assert a match. This simulator preserves ciphertext and makes no decoding claim.</p><p><a href="https://www.cia.gov/legacy/headquarters/kryptos-sculpture/" target="_blank" rel="noreferrer">CIA · sculpture, copper & transcript</a><br><a href="https://www.elonka.com/kryptos/transcript.html" target="_blank" rel="noreferrer">Elonka Dunin · cross-checked transcript</a><br><a href="https://elonka.com/kryptos/" target="_blank" rel="noreferrer">Dunin · photographs & light context</a><br><a href="https://www.cia.gov/readingroom/docs/kryptos%20sculpture%5B15267759%5D.pdf" target="_blank" rel="noreferrer">CIA released Intellipedia · 8 ft screen description</a><br><a href="https://www.nsa.gov/portals/75/documents/news-features/declassified-documents/cia-kryptos-sculpture/KRYPTOS_Summary.pdf" target="_blank" rel="noreferrer">NSA summary · about 3 m / 10 ft description (p. 2)</a><br><a href="https://jimsanborn.net/content.html#PUBLIC_SPACES" target="_blank" rel="noreferrer">Sanborn · overall installation envelope, not panel dimensions</a><br><a href="https://commons.wikimedia.org/wiki/File:Art_made_of_%22code%22_named_Kryptos_sits_on_the_grounds_of_the_C.I.A._Headquarters_in_Virginia_LCCN2011631531.tif" target="_blank" rel="noreferrer">Highsmith / Library of Congress · held-out optical reference (not fitted)</a><br><a href="https://voynich.net/Kryptos/" target="_blank" rel="noreferrer">Gillogly · independent viewpoints, unverified capture times</a><br><a href="https://gml.noaa.gov/grad/solcalc/calcdetails.html" target="_blank" rel="noreferrer">NOAA · solar calculation method</a></p></details></div></section><section class="evidence" style="margin:2rem 0"><div class="sectionhead">06 / IMAGE-SPACE EVIDENCE WORKSPACE</div><p>Source-pixel observations, not surveyed geometry. Loading evidence does not alter the screen or assign physical scale. Photographs are linked, never redistributed. Partial rubbing coverage does not make the whole screen measured.</p><div class="actions"><button id="loadBoundary">Load 44 boundary picks</button><button id="loadRubbing">Load partial rubbing record</button><button id="importEvidence">Import observation JSON</button><input id="evidenceFile" type="file" accept="application/json" hidden></div><p id="evidenceStatus" role="status">No evidence loaded. State exports preserve loaded observation records and provenance.</p><canvas id="evidenceCanvas" width="768" height="500" style="width:100%;max-height:500px;object-fit:contain;background:#182b22" aria-label="Derived source-pixel landmarks only; source photograph excluded"></canvas><p id="traceLabel"></p><canvas id="traceCanvas" width="649" height="500" style="width:100%;max-height:500px;object-fit:contain;background:#182b22" aria-label="Partial uncalibrated rubbing contour; separate source frame" hidden></canvas><pre id="evidenceDetails" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></section><section class="evidence" style="margin:2rem 0"><div class="sectionhead">07 / CONDITIONAL PHOTO CONSTRAINTS</div><p><strong>Visible strip only · H=1 is dimensionless.</strong> This is a conditional pinhole-camera family, not a surveyed whole panel. 21 non-K4 glyph correspondences: 14 training, 7 held out during camera optimization. Those held-out points were subsequently inspected for exploratory model selection; they are <strong>not untouched final validation</strong>. Highsmith remains unused. Original photographs are excluded.</p><button id="loadPhoto">Load verified conditional photo evidence</button><p id="photoStatus" role="status"></p><label>First-camera focal assumption<select id="photoCase"><option>400</option><option>600</option><option>800</option><option>1200</option><option>2000</option><option>4000</option></select></label><label>Inspect non-K4 glyph<select id="photoFeature"></select></label><label>Strip view yaw · radians<input id="photoYaw" type="range" min="-3.14159" max="3.14159" step="0.02"></label><label>Strip view elevation · radians<input id="photoPitch" type="range" min="0.05" max="1.5" step="0.02"></label><label>Residual-vector magnification<select id="photoResidualScale"><option>1</option><option>10</option><option>20</option></select></label><p>No metric scale, bearing, date or unobserved screen extension is assigned. Selecting a case affects this evidence preview only. Its silhouette endpoints are not verified joins. Sparse glyph points are conditional positions, not traced apertures.</p><canvas id="photoProfiles" width="820" height="270" style="width:100%;background:#182b22" aria-label="Comparison of dimensionless visible-strip profiles"></canvas><div style="display:flex;flex-wrap:wrap;gap:1rem"><canvas id="photoStrip" width="620" height="500" style="width:min(100%,620px);background:#182b22" aria-label="Conditional three dimensional strip with sparse training and held-out points"></canvas><canvas id="photoResiduals" width="660" height="500" style="width:min(100%,660px);background:#182b22" aria-label="Second-source image coordinates and magnified reprojection residual vectors"></canvas></div><p id="photoPoint" class="mono"></p><div style="overflow-x:auto"><table><thead><tr><th>f₁ assumed px</th><th>f₂ fit px</th><th>Train RMS px</th><th>Held-out RMS px</th><th>Held-out max px</th><th>Length/H</th><th>Sagitta/H</th><th>Exploratory interpretation</th></tr></thead><tbody id="photoRows"></tbody></table></div><p id="photoDiagnostics"></p><p>800/1200px scenarios remain nonunique; 4000px has a poor cross-view fit and reaches the second-camera focal bound. Manual bounding-box centers have unquantified systematic errors. <a href="evidence/photo/CALIBRATION_REPORT.md">Full report</a> · <a href="evidence/photo/IMPORT_NOTES.md">Import limits</a> · <a href="https://voynich.net/Kryptos/" target="_blank" rel="noreferrer">Original sources</a></p></section><footer>AN ORIGINAL EXPERIMENTAL WORKBENCH · NOT A SURVEYED RECONSTRUCTION</footer></main><script type="module" src="app.mjs?rev=20261022-read-safe-r3"></script></body></html>
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kryptos · Light Laboratory</title><link rel="icon" href="icon.svg" type="image/svg+xml"><link rel="stylesheet" href="style.css?rev=20261023-clues-1"></head><body><div role="status" style="padding:12px;background:#593c20;color:#fff1c4;text-align:center;font:14px system-ui">VALIDATION CANDIDATE · accepted decryption + render worker r2 / opaque-set · unpromoted · browser QA pending · <a href="/" style="color:white">verified main application</a></div><header><div class="brand">K / L <span>KRYPTOS · LIGHT LABORATORY</span></div><div class="headerstatus"><strong id="headerLight"></strong><span class="tag">UNSURVEYED MODEL · v4</span></div></header><main><section class="intro"><div><p class="eyebrow">A STUDY IN LIGHT, SHADOW & GEOMETRY</p><h1>Explore how light moves through Kryptos.</h1><p style="max-width:78ch">Kryptos is Jim Sanborn’s encrypted sculpture at CIA headquarters in Langley, Virginia. This interactive laboratory explores a hypothesis: could sunlight passing through its cut-out letters create patterns relevant to its fourth encrypted section, K4?</p><p style="max-width:78ch">Examine how the date, time, light direction and assumed sculpture geometry change the projected light. <a href="https://www.cia.gov/legacy/headquarters/kryptos-sculpture/" target="_blank" rel="noreferrer">About the sculpture · CIA</a> · <a href="#evidence">Evidence & assumptions</a></p><p class="modelnote" style="font-size:12px;max-width:85ch">This is a research simulator, not a demonstrated solution. The reconstruction is not surveyed, and an apparent alignment is not evidence of the artist’s intent.</p></div><div class="metrics"><div><small id="modeRead">REAL SUN</small><strong id="azRead"></strong><span>azimuth · clockwise from north</span></div><div><small>GEOMETRIC ELEVATION</small><strong id="elRead"></strong><span id="dayRead"></span></div></div></section><section aria-labelledby="start-heading" style="border-top:1px solid var(--line);padding:14px 0 22px;margin-bottom:12px"><h2 id="start-heading" style="font:17px Georgia;margin:0">Start here</h2><ol style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px 28px;padding-left:20px;font-size:12px;color:var(--muted)"><li>Choose a date and time for calculated <strong>Real sun</strong>, or select <strong>Manual light</strong> for an experiment.</li><li>Orbit or zoom the model and inspect the letter openings and projected light.</li><li>Change one geometry assumption at a time and compare what moves.</li><li>Export the settings as JSON so a result can be reproduced.</li></ol></section><nav class="mode-navigation" aria-label="Laboratory mode"><button id="opticalMode" aria-pressed="true">Experimental K4 light</button><button id="acceptedMode" aria-pressed="false">How K1–K3 were solved</button></nav><p id="modeGuidance" role="status">Experimental optics: adjust assumptions and inspect projected light. No K4 solution is claimed.</p><div class="workbench" id="workbench"><aside id="lightControls"><div class="sectionhead">01 / LIGHT SOURCE</div><div class="seg"><button id="real">Real sun</button><button id="manual">Manual light</button></div><div id="realControls"><label>New York local date & time<input type="datetime-local" id="local" step="60"></label><small>America/New_York · historical DST. Repeated fall times use earlier occurrence.</small><label>Scrub local day<input id="scrub" type="range" min="0" max="1439" step="5"></label><button id="play">▶ Play day</button><canvas id="path" height="65" aria-label="Daily solar elevation path"></canvas></div><div id="manualControls"><label>Azimuth <output id="maO"></output><input id="ma" type="range" min="0" max="360" value="180"></label><label>Elevation <output id="meO"></output><input id="me" type="range" min="-10" max="90" value="45"></label></div><p id="timeRead" class="mono"></p><div class="sectionhead">02 / PHYSICAL SCENARIOS</div><label>Study extent<select id="extent"><option value="screen">Full screen · two curves</option><option value="crop">Original isolated K4 control</option></select></label><label>Height evidence<select id="heightScenario"><option value="cia8">CIA description · 8 ft / 2.4384 m</option><option value="nsa10">NSA summary · about 3 m (10 ft)</option><option value="custom">Custom hypothesis</option><option value="crop">K4 crop control · assumed height</option></select></label><p id="modelNote" class="modelnote"></p><p class="warning">UNCALIBRATED · all dimensions editable</p><div class="sectionhead">03 / OPTICAL SCENARIOS</div><div id="opticalControls"><label>Copper thickness<select id="thicknessScenario"><option value="ideal">Ideal sheet · 0 mm control</option><option value="reporter-quarter">SPYSCAPE narrative · 6.35 mm</option><option value="memo-half">1991 memo · 12.7 mm</option><option value="custom">Custom hypothesis</option></select></label><label>Custom thickness · mm<input type="number" id="thickness" min="0" max="50" step="0.1"></label><label>Sun source<select id="sunSource"><option value="point">Point-direction control</option><option value="disk">Finite uniform disk · preview</option></select></label><label>Angular radius · degrees<input id="solarRadius" type="range" min="0" max="0.5" step="0.0001"></label><label>Disk quadrature<select id="sunSamples"><option value="9">9 directions · quick preview</option><option value="25">25 directions · preview</option><option value="49">49 directions · slower preview</option><option value="64">64 directions · slow comparison</option></select></label><small>Separate reported thickness alternatives, not a measured uncertainty interval. Finite disk integrates visibility through the entire solid scene. Preview sampling may not resolve narrow penumbras; colors include artistic ambient light, not absolute lux.</small></div><div id="geometry"></div><label class="check"><input type="checkbox" id="boundedReceiver">Bounded receiver patch (hypothesis)</label><div id="physicalControls"><label class="check"><input type="checkbox" id="tree"> Approximate tree at cipher outer end</label><small>Tree shape, size and offset are hypotheses. Its rendered mesh also blocks ground light.</small></div><p id="modelMetrics" class="mono"></p><button id="flat">Flat-screen control · 45°</button><small>Flat, square-on panel. Vertical height projects 1:1 at 45°. Receiver is horizontal.</small></aside><section id="acceptedPanel" hidden><p class="learning-guide">Follow accepted classical decryptions, one letter or transformation at a time. Choose K1, K2 or K3, then Step or Play. The mint marker links an original carved letter to its assumed location on this model; it does not certify its physical dimensions. The corrected K2 insertion has no carved aperture. Camera and light do not participate in these decryptions.</p><div id="acceptedHost"></div></section><section class="viewport"><div class="viewtools"><span id="viewRead">ORTHOGRAPHIC 3D / FULL SCREEN</span><div><button data-view="front">Front</button><button data-view="back">Back</button><button data-view="top">Top</button><button data-view="orbit">Orbit</button><button id="focus">Focus K4</button></div></div><details open class="modelnote"><summary>Measured diagnostics · validation candidate</summary><pre id="diagnostics" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></details><div><button id="retryGeometry">Retry mesh</button><button id="cancelGeometry">Cancel mesh update</button><small>On failure or cancellation, no previous mesh is displayed. Current inputs remain editable.</small></div><div id="renderStatus" role="status" class="modelnote"></div><div class="scene-stack" style="position:relative"><canvas id="scene" aria-label="Interactive 3D copper stencil and geometric ground shadow" tabindex="0"></canvas><canvas id="learningOverlay" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"></canvas></div><div class="scenefoot"><span>Drag to orbit · scroll / pinch to zoom</span><span><i class="copper"></i>Copper <i class="sun"></i>Direct sunlight</span></div><div id="selection" class="selection"></div></section></div><section class="lower"><div class="cipher"><div class="sectionhead">04 / RAW K4 · 97 CHARACTERS</div><p>Canonical K4 uses 31 columns, beginning at row 25, column 28. Full-screen mode preserves the complete cipher and tableau transcript lines (29–33 characters), at an assumed constant physical pitch. Its glyph shapes and spacing are unmeasured. Click a K4 letter to inspect its index.</p><p class="k4-clue-guide"><strong>Confirmed clues only</strong> · shown directly beneath each encrypted line. Mint letters are confirmed; neutral dots (·) are unknown. Positions count the first O as 1. This is not a solved message.</p><div id="letters"></div><div class="actions"><button id="export">↓ Export state JSON</button><button id="import">↑ Import state JSON</button><button id="reset">Reset</button><button id="observation">Reported observation preset</button><input id="file" type="file" accept="application/json" hidden></div><small>JSON restores optical inputs. Educational selection is included as reference metadata; it does not change the physical solver.</small><p id="notice" role="status"></p></div><div class="evidence" id="evidence"><div class="sectionhead">05 / EVIDENCE & PROVENANCE</div><details open><summary>Computationally verified</summary><p>Geometric ray–plane intersections; shared aperture/material geometry for panel and shadow; 45° / 30° / 60° controls; 97-character transcript and indices; JSON roundtrip; historical DST; solar benchmarks within 0.3°.</p></details><details open><summary>Assumed & approximate</summary><p>Full-screen mode includes both curved text regions, the surrounding cipher, a reverse-reading tableau, an assumed mid-height seam and an approximate tree at the cipher outer end. Two sine lobes, total chord span, heading, clearance and tree size remain hypotheses. CIA describes an 8 ft screen; an NSA summary says about 10 ft. These are competing documentary scenarios, not surveyed certainty. The isolated K4 control omits surrounding text and substitutes 27 blank copper cells for K3. Full-screen glyphs use equal physical stroke cells and approximate counter bridges; they are original generic shapes, not traced serifed hand-cut lettering. Physical pitch is assumed. Copper can be an ideal sheet or a normal-offset solid with aperture walls using separately reported ¼-inch and ½-inch scenarios. Finite uniform solar-disk sampling and tilted/bounded receiver patches are optional numerical experiments. Their preview convergence is not measured site accuracy. Refraction, limb darkening, self-shadow intensity on copper, pools, granite, fasteners, terrain, buildings and photo calibration are omitted. K2 coordinates are a reference location, not a survey.</p></details><details><summary>How to read this experiment</summary><p>Copper blocks sunlight: the dark ground silhouette is the union of its material shadows. The missing copper makes bright letters inside it. Light direction controls ground displacement; incidence depends on each curved surface normal. Camera angle only changes your view. Back views naturally mirror the openings. A projected center marker does not guarantee an unoccluded bright letter.</p></details><details><summary>Unsupported observations & source record</summary><p id="obs">Reported OBKR / NGKSSO / NFBNYP / AUEKCAR groupings are unverified user observations. The preset selects those letters only; it does not tune geometry or assert a match. This simulator preserves ciphertext and makes no decoding claim.</p><p><a href="https://www.cia.gov/legacy/headquarters/kryptos-sculpture/" target="_blank" rel="noreferrer">CIA · sculpture, copper & transcript</a><br><a href="https://www.elonka.com/kryptos/transcript.html" target="_blank" rel="noreferrer">Elonka Dunin · cross-checked transcript</a><br><a href="https://elonka.com/kryptos/" target="_blank" rel="noreferrer">Dunin · photographs & light context</a><br><a href="https://www.cia.gov/readingroom/docs/kryptos%20sculpture%5B15267759%5D.pdf" target="_blank" rel="noreferrer">CIA released Intellipedia · 8 ft screen description</a><br><a href="https://www.nsa.gov/portals/75/documents/news-features/declassified-documents/cia-kryptos-sculpture/KRYPTOS_Summary.pdf" target="_blank" rel="noreferrer">NSA summary · about 3 m / 10 ft description (p. 2)</a><br><a href="https://jimsanborn.net/content.html#PUBLIC_SPACES" target="_blank" rel="noreferrer">Sanborn · overall installation envelope, not panel dimensions</a><br><a href="https://commons.wikimedia.org/wiki/File:Art_made_of_%22code%22_named_Kryptos_sits_on_the_grounds_of_the_C.I.A._Headquarters_in_Virginia_LCCN2011631531.tif" target="_blank" rel="noreferrer">Highsmith / Library of Congress · held-out optical reference (not fitted)</a><br><a href="https://voynich.net/Kryptos/" target="_blank" rel="noreferrer">Gillogly · independent viewpoints, unverified capture times</a><br><a href="https://gml.noaa.gov/grad/solcalc/calcdetails.html" target="_blank" rel="noreferrer">NOAA · solar calculation method</a></p></details></div></section><section class="evidence" style="margin:2rem 0"><div class="sectionhead">06 / IMAGE-SPACE EVIDENCE WORKSPACE</div><p>Source-pixel observations, not surveyed geometry. Loading evidence does not alter the screen or assign physical scale. Photographs are linked, never redistributed. Partial rubbing coverage does not make the whole screen measured.</p><div class="actions"><button id="loadBoundary">Load 44 boundary picks</button><button id="loadRubbing">Load partial rubbing record</button><button id="importEvidence">Import observation JSON</button><input id="evidenceFile" type="file" accept="application/json" hidden></div><p id="evidenceStatus" role="status">No evidence loaded. State exports preserve loaded observation records and provenance.</p><canvas id="evidenceCanvas" width="768" height="500" style="width:100%;max-height:500px;object-fit:contain;background:#182b22" aria-label="Derived source-pixel landmarks only; source photograph excluded"></canvas><p id="traceLabel"></p><canvas id="traceCanvas" width="649" height="500" style="width:100%;max-height:500px;object-fit:contain;background:#182b22" aria-label="Partial uncalibrated rubbing contour; separate source frame" hidden></canvas><pre id="evidenceDetails" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></section><section class="evidence" style="margin:2rem 0"><div class="sectionhead">07 / CONDITIONAL PHOTO CONSTRAINTS</div><p><strong>Visible strip only · H=1 is dimensionless.</strong> This is a conditional pinhole-camera family, not a surveyed whole panel. 21 non-K4 glyph correspondences: 14 training, 7 held out during camera optimization. Those held-out points were subsequently inspected for exploratory model selection; they are <strong>not untouched final validation</strong>. Highsmith remains unused. Original photographs are excluded.</p><button id="loadPhoto">Load verified conditional photo evidence</button><p id="photoStatus" role="status"></p><label>First-camera focal assumption<select id="photoCase"><option>400</option><option>600</option><option>800</option><option>1200</option><option>2000</option><option>4000</option></select></label><label>Inspect non-K4 glyph<select id="photoFeature"></select></label><label>Strip view yaw · radians<input id="photoYaw" type="range" min="-3.14159" max="3.14159" step="0.02"></label><label>Strip view elevation · radians<input id="photoPitch" type="range" min="0.05" max="1.5" step="0.02"></label><label>Residual-vector magnification<select id="photoResidualScale"><option>1</option><option>10</option><option>20</option></select></label><p>No metric scale, bearing, date or unobserved screen extension is assigned. Selecting a case affects this evidence preview only. Its silhouette endpoints are not verified joins. Sparse glyph points are conditional positions, not traced apertures.</p><canvas id="photoProfiles" width="820" height="270" style="width:100%;background:#182b22" aria-label="Comparison of dimensionless visible-strip profiles"></canvas><div style="display:flex;flex-wrap:wrap;gap:1rem"><canvas id="photoStrip" width="620" height="500" style="width:min(100%,620px);background:#182b22" aria-label="Conditional three dimensional strip with sparse training and held-out points"></canvas><canvas id="photoResiduals" width="660" height="500" style="width:min(100%,660px);background:#182b22" aria-label="Second-source image coordinates and magnified reprojection residual vectors"></canvas></div><p id="photoPoint" class="mono"></p><div style="overflow-x:auto"><table><thead><tr><th>f₁ assumed px</th><th>f₂ fit px</th><th>Train RMS px</th><th>Held-out RMS px</th><th>Held-out max px</th><th>Length/H</th><th>Sagitta/H</th><th>Exploratory interpretation</th></tr></thead><tbody id="photoRows"></tbody></table></div><p id="photoDiagnostics"></p><p>800/1200px scenarios remain nonunique; 4000px has a poor cross-view fit and reaches the second-camera focal bound. Manual bounding-box centers have unquantified systematic errors. <a href="evidence/photo/CALIBRATION_REPORT.md">Full report</a> · <a href="evidence/photo/IMPORT_NOTES.md">Import limits</a> · <a href="https://voynich.net/Kryptos/" target="_blank" rel="noreferrer">Original sources</a></p></section><footer>AN ORIGINAL EXPERIMENTAL WORKBENCH · NOT A SURVEYED RECONSTRUCTION</footer></main><script type="module" src="app.mjs?rev=20261023-clues-1"></script></body></html>
diff --git a/candidate/k4-clues.mjs b/candidate/k4-clues.mjs
new file mode 100644
index 0000000..b02592e
--- /dev/null
+++ b/candidate/k4-clues.mjs
@@ -0,0 +1,24 @@
+// Confirmed K4 clues only. One-based position1 is the first O of OBKR.
+export const K4_CLUES=Object.freeze([
+ Object.freeze({start:22,cipher:'FLRV',plain:'EAST'}),
+ Object.freeze({start:26,cipher:'QQPRNGKSS',plain:'NORTHEAST'}),
+ Object.freeze({start:64,cipher:'NYPVTT',plain:'BERLIN'}),
+ Object.freeze({start:70,cipher:'MZFPK',plain:'CLOCK'})
+]);
+export const K4_CLUE_MASK='·'.repeat(21)+'EASTNORTHEAST'+'·'.repeat(29)+'BERLINCLOCK'+'·'.repeat(23);
+export function k4ClueCells(cipher){
+ if(cipher.length!==97)throw Error('Expected97K4characters');
+ for(const clue of K4_CLUES)if(cipher.slice(clue.start-1,clue.start-1+clue.cipher.length)!==clue.cipher)throw Error('Confirmed clue does not match canonical K4');
+ return Array.from({length:124},(_,slot)=>{const i=slot-26,line=Math.floor(slot/31);return{position:i>0?i:null,column:slot%31+1,cipherRow:line*2+1,plainRow:line*2+2,cipher:i>0?cipher[i-1]:'·',plain:i>0?K4_CLUE_MASK[i-1]:'',known:i>0&&K4_CLUE_MASK[i-1]!=='·'};});
+}
+export function mountK4Clues(host,cipher,onSelect,doc=document){
+ host.setAttribute('aria-label','K4 ciphertext with confirmed clues directly beneath each line');
+ for(const cell of k4ClueCells(cipher)){
+  const encrypted=doc.createElement(cell.position?'button':'span');encrypted.textContent=cell.cipher;encrypted.style.gridColumn=String(cell.column);encrypted.style.gridRow=String(cell.cipherRow);encrypted.dataset.kind='cipher';
+  if(cell.position){encrypted.dataset.i=cell.position;encrypted.title=`K4 #${cell.position} · ciphertext ${cell.cipher}`;encrypted.setAttribute('aria-label',encrypted.title);encrypted.onclick=()=>onSelect(cell.position);}else{encrypted.className='blank';encrypted.setAttribute('aria-hidden','true');}
+  host.append(encrypted);
+  const plain=doc.createElement('span');plain.textContent=cell.plain;plain.className=cell.position?'k4-clue '+(cell.known?'known':'unknown'):'blank';plain.dataset.kind='plain';plain.style.gridColumn=String(cell.column);plain.style.gridRow=String(cell.plainRow);
+  if(cell.position){plain.dataset.position=cell.position;plain.title=`K4 #${cell.position} · ${cell.known?'confirmed '+cell.plain:'unknown'}`;plain.setAttribute('aria-label',plain.title);}else plain.setAttribute('aria-hidden','true');
+  host.append(plain);
+ }
+}
