diff --git a/qa/k4-clue-alignment.html b/qa/k4-clue-alignment.html
new file mode 100644
index 0000000..b3ecd8e
--- /dev/null
+++ b/qa/k4-clue-alignment.html
@@ -0,0 +1,3 @@
+<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>K4 clue alignment QA</title><style>body{font:15px system-ui;background:#18251f;color:#edf2e9}iframe{display:block;border:2px solid #d3edb4;margin:12px 0;max-width:none}pre{white-space:pre-wrap}button{padding:10px}</style><h1>Confirmed K4 clues · rendered alignment</h1><p>Actual shared31column grid at390px and1280px frame widths. Narrow layout only, not real-device touch testing.</p><pre id="results">Running…</pre><script type="module">
+const results=[],out=document.getElementById('results');for(const width of[390,1280]){const frame=document.createElement('iframe');frame.width=width;frame.height=530;frame.title=`K4 aligned clue grid at${width}px`;document.body.append(frame);const ready=new Promise(resolve=>frame.onload=resolve);frame.src='../dist/#letters';await ready;for(let attempt=0;attempt<250&&frame.contentDocument.querySelectorAll('#letters button').length!==97;attempt++)await new Promise(r=>setTimeout(r,20));await new Promise(r=>requestAnimationFrame(r));const doc=frame.contentDocument,encrypted=[...doc.querySelectorAll('#letters button')],plain=[...doc.querySelectorAll('[data-position]')];let maxX=0,maxW=0,above=0;for(let i=0;i<97;i++){const a=encrypted[i].getBoundingClientRect(),b=plain[i].getBoundingClientRect();maxX=Math.max(maxX,Math.abs(a.x-b.x));maxW=Math.max(maxW,Math.abs(a.width-b.width));if(b.y<a.bottom-.01)above++;}const known=plain.filter(e=>e.classList.contains('known')).length,unknown=plain.filter(e=>e.classList.contains('unknown')).length,overflow=doc.documentElement.scrollWidth>width;encrypted[21].click();const selected=doc.getElementById('selection').textContent.includes('K4 #22 / 97');results.push({width,pairs:encrypted.length,known,unknown,maxHorizontalErrorPx:maxX,maxWidthErrorPx:maxW,cluesNotBelow:above,pageOverflow:overflow,selectionWorks:selected,pass:encrypted.length===97&&known===24&&unknown===73&&maxX<.01&&maxW<.01&&above===0&&!overflow&&selected});out.textContent=JSON.stringify(results,null,2);}out.textContent+='\n'+(results.every(r=>r.pass)?'PASS both rendered widths':'FAIL');
+</script>
diff --git a/tests/k4-clues.test.mjs b/tests/k4-clues.test.mjs
