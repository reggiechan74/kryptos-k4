+ svg+=polygon(rockBase,'#333e37');const apex=[1.95,-1.12,.58];for(let i=0;i<crown.length;i++)svg+=polygon([crown[i],crown[(i+1)%crown.length],apex],['#465449','#586154','#3c4940','#68705e','#4c594c'][i]);
