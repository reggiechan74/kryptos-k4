+// Original illustrative drawing based on inspected reference photographs.
+// Local unitless coordinates are drawing choices, not surveyed dimensions/bearings.
+export const ENTRANCE_SOURCES=Object.freeze([
+ ['CIA · entrance and courtyard components','https://www.cia.gov/legacy/headquarters/kryptos-sculpture/'],
+ ['Dunin · aerial context and explicit orientation uncertainty','https://www.elonka.com/kryptos/KryptosAerial.html'],
+ ['Gillogly · compass close-up, linked by Dunin','https://www.voynich.net/Kryptos/full/compass1.jpg'],
+ ['Dunin · west-entrance aerial crop','https://www.elonka.com/kryptos/AerialImages/WalkwayEnlarged.jpg'],
+ ['Chris Hanson ·2005 attendee account, printed page5','https://www.thekryptosproject.com/events/dinners/pdfs/2005/2005_hanson.pdf']
+]);
+const finite=n=>Number.isFinite(n);
+export function entranceDrawing(view='oblique',labels=true){
+ if(!['oblique','plan'].includes(view))throw Error('Unknown entrance view');
+ const project=([x,z,h=0])=>{if(![x,z,h].every(finite))throw Error('Invalid illustrative vertex');return[390+x*100+z*(view==='oblique'?20:0),235+z*(view==='oblique'?65:100)-h*(view==='oblique'?90:0)];};
+ const points=p=>p.map(v=>project(v).map(n=>n.toFixed(2)).join(',')).join(' ');
+ const polygon=(p,fill,extra='')=>`<polygon points="${points(p)}" fill="${fill}" ${extra}/>`;
+ const curve=p=>`M${p.map(v=>project(v).map(n=>n.toFixed(2)).join(',')).join('L')}`;
+ const text=(p,s,fill='#e9eadc')=>{const[x,y]=project(p);return`<text x="${x}" y="${y}" text-anchor="middle" dominant-baseline="middle" fill="${fill}" font-family="Georgia,serif" font-size="22">${s}</text>`;};
+ const slab=[[-2.55,-1.65],[1.55,-1.65],[2.25,-1.1],[2.35,1.65],[-2.55,1.65]],foot=slab.map(([x,z])=>[x,z,-.10]);
