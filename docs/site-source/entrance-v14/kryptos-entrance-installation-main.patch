+// Original illustrative drawing based on inspected reference photographs.
+// Local unitless coordinates are drawing choices, not surveyed dimensions/bearings.
+export const ENTRANCE_SOURCES=Object.freeze([
+ ['CIA · entrance and courtyard components','https://www.cia.gov/legacy/headquarters/kryptos-sculpture/'],
+ ['Dunin · aerial context and explicit orientation uncertainty','https://www.elonka.com/kryptos/KryptosAerial.html'],
+ ['Gillogly · compass close-up, linked by Dunin','https://www.voynich.net/Kryptos/full/compass1.jpg'],
+ ['Dunin · west-entrance aerial crop','https://www.elonka.com/kryptos/AerialImages/WalkwayEnlarged.jpg'],
+ ['Chris Hanson ·2005 attendee account, printed page5','https://www.thekryptosproject.com/events/dinners/pdfs/2005/2005_hanson.pdf']
+]);
+const finite=n=>Number.isFinite(n);
+export function entranceDrawing(view='oblique',labels=true){
+ if(!['oblique','plan'].includes(view))throw Error('Unknown entrance view');
+ const project=([x,z,h=0])=>{if(![x,z,h].every(finite))throw Error('Invalid illustrative vertex');return[390+x*100+z*(view==='oblique'?20:0),235+z*(view==='oblique'?65:100)-h*(view==='oblique'?90:0)];};
+ const points=p=>p.map(v=>project(v).map(n=>n.toFixed(2)).join(',')).join(' ');
+ const polygon=(p,fill,extra='')=>`<polygon points="${points(p)}" fill="${fill}" ${extra}/>`;
+ const curve=p=>`M${p.map(v=>project(v).map(n=>n.toFixed(2)).join(',')).join('L')}`;
+ const text=(p,s,fill='#e9eadc')=>{const[x,y]=project(p);return`<text x="${x}" y="${y}" text-anchor="middle" dominant-baseline="middle" fill="${fill}" font-family="Georgia,serif" font-size="22">${s}</text>`;};
+ const slab=[[-2.55,-1.65],[1.55,-1.65],[2.25,-1.1],[2.35,1.65],[-2.55,1.65]],foot=slab.map(([x,z])=>[x,z,-.10]);
+ const rose=Array.from({length:97},(_,i)=>[Math.cos(i/96*Math.PI*2)*1.2,Math.sin(i/96*Math.PI*2)*1.2,.008]);
+ const compassAxes=[[[.6,1.03],[.83,1.42]],[[-.6,-1.03],[-.83,-1.42]],[[-1.03,.6],[-1.41,.82]],[[1.03,-.6],[1.41,-.82]]];
+ const needle=[[-1.10,.68,.01],[.05,.15,.01],[1.15,-.68,.01],[-.04,-.10,.01],[-1.10,.68,.01]];
+ const rockBase=[[1.42,-1.40,.03],[1.75,-1.62,.03],[2.26,-1.43,.03],[2.54,-1.06,.03],[2.38,-.70,.03],[1.88,-.61,.03],[1.42,-.93,.03]],crown=[[1.54,-1.33,.30],[1.89,-1.46,.42],[2.29,-1.15,.33],[2.23,-.87,.25],[1.87,-.77,.37]];
+ let svg=`<svg viewBox="0 0 780 470" role="img" aria-labelledby="entrance-svg-title entrance-svg-desc" xmlns="http://www.w3.org/2000/svg"><title id="entrance-svg-title">Entrance compass rose and adjacent lodestone · illustrative ${view==='plan'?'overhead':'oblique'} view</title><desc id="entrance-svg-desc">A circle, four engraved letters and a fixed elongated carved needle lie flat in a granite slab. An irregular dark lodestone is adjacent. Engraved N is not registered to true north. Shape, spacing, relief and presentation orientation are illustrative, not measured.</desc><rect width="780" height="470" fill="#1a2c23"/><ellipse cx="425" cy="285" rx="295" ry="130" fill="#102018" opacity=".4"/>`;
+ svg+=polygon(foot,'#50564d')+polygon(slab,'#858b7b','stroke="#a0a495" stroke-width="1"');
+ // A small number of fixed mineral flecks: decorative texture, no optical simulation.
+ for(let i=0;i<95;i++){const x=-2.35+((i*37)%97)/97*4.3,z=-1.45+((i*53)%89)/89*2.85;if(x>1.5&&z<-.6)continue;const[a,b]=project([x,z,.001]);svg+=`<circle cx="${a}" cy="${b}" r="${i%3===0?1.1:.6}" fill="${i%2?'#abb09e':'#626d5f'}"/>`;}
+ svg+=`<path d="${curve([[-2.24,-1.65],[-2.16,0],[-2.10,1.65]])}" stroke="#424d41" stroke-width="2" fill="none"/><path d="${curve(rose)}" stroke="#374537" stroke-width="1.8" fill="none"/>`;
+ for(const axis of compassAxes)svg+=`<path d="${curve(axis)}" stroke="#354434" stroke-width="2" fill="none"/>`;
+ svg+=text([.66,1.15,.01],'N','#364334')+text([-.66,-1.15,.01],'S','#364334')+text([-1.15,.66,.01],'E','#364334')+text([1.15,-.66,.01],'W','#364334');
