+import test from'node:test';import assert from'node:assert/strict';import{defaults}from'../dist/math.mjs';import{mesh,screenGeometry}from'../dist/geometry.mjs';import{CIPHER_ROWS,TABLEAU_ROWS}from'../dist/transcript.mjs';import{rayBlocked}from'../dist/physics.mjs';
+test('cipher F and reverse tableau F are the same through-cut openings from either side of finite copper',()=>{const s=defaults();Object.assign(s.geometry,{curvature:0,heading:0,tree:false});Object.assign(s.optics,{thickness:.00635,thicknessScenario:'reporter-quarter'});const m=mesh(s),{at,length}=screenGeometry(s.geometry),unit=m.metrics.physicalSquareStroke;const cipherCol=CIPHER_ROWS[0].indexOf('F')+Math.floor((33-CIPHER_ROWS[0].length)/2),j=TABLEAU_ROWS[0].indexOf('F'),tableauCol=32-j-Math.floor((33-TABLEAU_ROWS[0].length)/2);
+function blocked(side,col,gx){const p=at((side+(col+.5)/33)/2+(gx-2)*unit/length,1-.5/28-3*unit/s.geometry.height);return[1,-1].map(sign=>rayBlocked([p[0],p[1],p[2]+sign],[0,0,-sign],m.tiles));}
+assert.deepEqual(blocked(0,cipherCol,0),[false,false],'front-reading F stem is open on left in world x, through both sides');assert.deepEqual(blocked(0,cipherCol,4),[true,true],'opposite bottom corner is copper through both sides');assert.deepEqual(blocked(1,tableauCol,4),[false,false],'tableau F stem is mirrored in front view, open on right');assert.deepEqual(blocked(1,tableauCol,0),[true,true],'tableau opposite corner is solid, never a separate printed decal');});
