+import test from'node:test';import assert from'node:assert/strict';import{readFileSync}from'node:fs';import{entranceDrawing,mountEntrance,ENTRANCE_SOURCES}from'../dist/entrance-installation.mjs';
+test('entrance drawings have finite geometry, accessible description and no claimed bearing or animated magnetic needle',()=>{for(const view of['oblique','plan']){const svg=entranceDrawing(view,true);assert.match(svg,/role="img" aria-labelledby="entrance-svg-title entrance-svg-desc"/);assert.match(svg,/fixed elongated carved needle lie flat/);assert.match(svg,/not registered to true north/);assert.match(svg,/no metric scale/);assert.doesNotMatch(svg,/NaN|Infinity|<animate|247\.5|220°/);assert.ok((svg.match(/<polygon/g)||[]).length>8);}assert.notEqual(entranceDrawing('oblique'),entranceDrawing('plan'));assert.doesNotMatch(entranceDrawing('plan',false),/ENGRAVED GRANITE/);assert.throws(()=>entranceDrawing('survey'));assert.ok(ENTRANCE_SOURCES.some(x=>x[1].includes('compass1.jpg')));});
+test('entrance camera and label controls alter illustration only and reset coherently',()=>{const buttons=['oblique','plan'].map(view=>({dataset:{entranceView:view},setAttribute(k,v){this[k]=v}})),label={checked:true},drawing={},status={},host={querySelector:s=>({'#entrance-drawing':drawing,'#entrance-view-status':status,'#entrance-labels':label}[s]),querySelectorAll:()=>buttons};const c=mountEntrance(host);assert.equal(buttons[0]['aria-pressed'],'true');buttons[1].onclick();assert.equal(c.getState().view,'plan');assert.equal(buttons[1]['aria-pressed'],'true');label.onchange({target:{checked:false}});assert.equal(c.getState().labels,false);c.reset();assert.deepEqual(c.getState(),{view:'oblique',labels:true});assert.match(host.innerHTML,/schematic, not survey scale/);assert.match(host.innerHTML,/separate from the courtyard copper screen/);assert.match(host.innerHTML,/No magnetic needle animation/);assert.ok(host.innerHTML.indexOf('Rose + lodestone')<host.innerHTML.indexOf('between installations'));assert.ok(host.innerHTML.indexOf('between installations')<host.innerHTML.indexOf('Copper screen'));});
+test('entrance integration preserves solver modules and exposes a separate labelled mode',()=>{const html=readFileSync(new URL('../dist/index.html',import.meta.url),'utf8'),app=readFileSync(new URL('../dist/app.mjs',import.meta.url),'utf8');assert.match(html,/id="entranceMode"[^>]*>Entrance · rose &amp; lodestone|id="entranceMode"[^>]*>Entrance · rose & lodestone/);assert.match(html,/id="entrancePanel"[^>]*hidden/);assert.match(html,/Confirmed clues only/);assert.match(app,/function draw\(\)\{if\(\$\('workbench'\)\.hidden\)return/);assert.match(app,/learningMode.pause\(\)/);});
