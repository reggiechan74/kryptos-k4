+++ b/qa/entrance-view.html
@@ -0,0 +1,3 @@
+<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Entrance installation responsive QA</title><style>body{background:#19251f;color:#edf2e9;font:14px system-ui}iframe{display:block;max-width:none;border:2px solid #d3edb4;margin:18px 0}pre{white-space:pre-wrap}</style><h1>Entrance view · responsive QA</h1><p>Complete Site at390px and1280px frame widths. No true-north registration or physical scale is implied. These are layout tests, not real-device touch tests.</p><p id="summary" role="status">Running…</p><pre id="results">Running…</pre><script type="module">
+const rows=[],out=document.getElementById('results');for(const width of[390,1280]){const f=document.createElement('iframe');f.width=width;f.height=950;f.title=`Entrance installation at${width}px`;document.body.append(f);const loaded=new Promise(r=>f.onload=r);f.src='../dist/#entrancePanel';await loaded;const d=f.contentDocument;for(let n=0;n<250&&(!f.contentWindow.kryptosQA||!d.getElementById('entranceMode').onclick);n++)await new Promise(r=>setTimeout(r,20));const state=JSON.stringify(f.contentWindow.kryptosQA.state());d.getElementById('entranceMode').click();const panel=d.getElementById('entrancePanel'),first=panel.querySelector('svg').outerHTML;panel.querySelector('[data-entrance-view=plan]').click();const changed=panel.querySelector('svg').outerHTML!==first;const check=panel.querySelector('#entrance-labels');check.checked=false;check.dispatchEvent(new f.contentWindow.Event('change'));const labelsOff=!panel.querySelector('svg').textContent.includes('ENGRAVED GRANITE');check.checked=true;check.dispatchEvent(new f.contentWindow.Event('change'));panel.querySelector('[data-entrance-view=oblique]').click();const unchanged=JSON.stringify(f.contentWindow.kryptosQA.state())===state;d.getElementById('opticalMode').click();const returned=panel.hidden&&!d.getElementById('workbench').hidden;d.getElementById('entranceMode').click();await new Promise(r=>f.contentWindow.requestAnimationFrame(r));const svg=panel.querySelector('svg').getBoundingClientRect(),overflow=d.documentElement.scrollWidth>width;const row={width,svgWidthPx:svg.width,visible:!panel.hidden,workbenchHidden:d.getElementById('workbench').hidden,accessibleSVG:panel.querySelector('svg').hasAttribute('aria-labelledby'),viewControlChangesSVG:changed,labelToggleWorks:labelsOff,opticalStateUnchanged:unchanged,returnsToOptics:returned,pageOverflow:overflow};row.pass=row.visible&&row.workbenchHidden&&row.accessibleSVG&&changed&&labelsOff&&unchanged&&returned&&!overflow&&svg.width>0&&svg.width<=width;rows.push(row);out.textContent=JSON.stringify(rows,null,2);}document.getElementById('summary').textContent=(rows.every(r=>r.pass)?'PASS both widths and controls':'FAIL')+' · '+rows.map(r=>r.width+'px: overflow '+r.pageOverflow+', controls '+r.viewControlChangesSVG+'/'+r.labelToggleWorks+', unchanged optics '+r.opticalStateUnchanged+', return '+r.returnsToOptics).join(' · ');
+</script>
